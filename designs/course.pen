                                                {
                                                  "type": "text",
                                                  "id": "nJQC7",
                                                  "name": "2AM is a self-taught 3D artist who spent years reverse- engineering professional anime character models to figure out exactly what makes them work, both artistically and technically. That obsessive process became the foundation of this course.",
                                                  "fill": "#a0a0a0ff",
                                                  "content": "2AM is a self-taught 3D artist who spent years reverse-\nengineering professional anime character models to figure out\nexactly what makes them work, both artistically and\ntechnically. That obsessive process became the foundation of\nthis course.",
                                                  "lineHeight": 1.5384615008412508,
                                                  "textAlignVertical": "middle",
                                                  "fontFamily": "Inter",
                                                  "fontSize": 15.600000381469727,
                                                  "fontWeight": "normal"
                                                },
                                                {
                                                  "type": "text",
                                                  "id": "7AZsm",
                                                  "name": "You'll learn the same methods 2AM uses to replicate stylized characters, covering the full pipeline: 3D modeling, texturing, rigging, animation, and Unity implementation, with reference models, exercises, and guidance at every stage.",
                                                  "fill": "#a0a0a0ff",
                                                  "content": "You'll learn the same methods 2AM uses to replicate stylized\ncharacters, covering the full pipeline: 3D modeling, texturing,\nrigging, animation, and Unity implementation, with reference\nmodels, exercises, and guidance at every stage.",
                                                  "lineHeight": 1.5384615008412508,
                                                  "textAlignVertical": "middle",
                                                  "fontFamily": "Inter",
                                                  "fontSize": 15.600000381469727,
                                                  "fontWeight": "normal"
                                                }
                                              ]
                                            }
