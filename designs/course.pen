                                  "children": [
                                    {
                                      "type": "frame",
                                      "id": "6sJzU",
                                      "name": "Paragraph",
                                      "stroke": {
                                        "align": "inside",
                                        "thickness": 1
                                      },
                                      "layout": "vertical",
                                      "gap": 25.059999465942383,
                                      "padding": [
                                        0,
                                        11.4399995803833,
                                        0,
                                        0
                                      ],
                                      "children": [
                                        {
                                          "type": "text",
                                          "id": "vmxIr",
                                          "name": "Hi everyone, 2AM here! I'm an independent 3D artist and lifelong creative who started my 3D journey five years ago to pursue creating my own games, characters, and animations. 3D modeling can be daunting, but seeing your ideas come to life is worth the journey.",
                                          "fill": "#333333ff",
                                          "content": "Hi everyone, 2AM here! I'm an independent 3D artist and lifelong creative who started\nmy 3D journey five years ago to pursue creating my own games, characters, and\nanimations. 3D modeling can be daunting, but seeing your ideas come to life is worth\nthe journey.",
                                          "lineHeight": 1.6516129278367566,
                                          "textAlignVertical": "middle",
                                          "fontFamily": "Inter",
                                          "fontSize": 15.5,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "text",
                                          "id": "Mf48n",
                                          "name": "Over the past few years I've completed 20+ 3D character projects spanning games, animation, and Vtubers. As a self-taught artist, I know how hard it is to find a workflow powerful enough to achieve your vision, so my focus has been on methods that eliminate guesswork at every stage. In this class, my goal is to give you everything you need to materialize your 3D character vision and freely implement it into a game or animation!",
                                          "fill": "#333333ff",
                                          "content": "Over the past few years I've completed 20+ 3D character projects spanning games,\nanimation, and Vtubers. As a self-taught artist, I know how hard it is to find a workflow\npowerful enough to achieve your vision, so my focus has been on methods that\neliminate guesswork at every stage. In this class, my goal is to give you everything you\nneed to materialize your 3D character vision and freely implement it into a game or\nanimation!",
                                          "lineHeight": 1.6516129278367566,
                                          "textAlignVertical": "middle",
                                          "fontFamily": "Inter",
                                          "fontSize": 15.5,
                                          "fontWeight": "normal"
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
